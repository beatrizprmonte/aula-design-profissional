#SISTEMA DE ESTOQUE: RETIRADA, REPOSIÇÃO, CONSULTA, HISTÓRICO E LOGIN COM SENHA

import random
from datetime import datetime #SISTEMA GUARDA DATA E HORA DE CADA MOVIMENTAÇÃO
from getpass import getpass #NÃO MOSTRA A SENHA ENQUANTO O USUARIO DIGITA NA TELA


# ---------------------------------------------------------------
# DADOS
# ---------------------------------------------------------------
estoque = {
    "mouse": 10,
    "monitor": 5,
    "gabinete": 15,
    "placa de video": 4,
    "ssd": 15,
    "teclado": 20,
    "headset": 5,
    "mousepad": 25,
    "microfone": 10,
    "webcam": 5,
    "water cooler": 5,
}

# Cada registro: {"data", "usuario", "tipo", "produto", "quantidade"}
historico = []

LIMITE_BAIXO = 5
MAX_TENTATIVAS = 3

# admin    -> pode tudo
# operador -> pode consultar, retirar e ver histórico/relatório
usuarios = {
    "admin": {"senha": "admin123", "perfil": "admin"},
    "operador": {"senha": "1234", "perfil": "operador"},
}


# FUNÇÕES 

def ler_numero(msg):
    """Lê um inteiro maior que zero. Retorna None se inválido."""
    try:
        valor = int(input(msg))
    except ValueError:
        print('Valor inválido, digite apenas números.')
        return None
    if valor <= 0:
        print('Digite um número maior que zero.')
        return None
    return valor


def confirmar(msg):
    """Pergunta S/N e repete até receber uma resposta válida."""
    while True:
        resp = input(f'{msg} (S/N) ').strip().upper()
        if resp in ('S', 'N'):
            return resp == 'S'
        print('Responda apenas com S ou N.')


def registrar(usuario, tipo, produto, quantidade):
    historico.append({
        "data": datetime.now().strftime('%d/%m/%Y %H:%M:%S'),
        "usuario": usuario,
        "tipo": tipo,
        "produto": produto,
        "quantidade": quantidade,
    })


def login():
    """Retorna (usuario, perfil) ou None após falhar o limite de tentativas."""
    print('\n===== LOGIN =====')
    for tentativa in range(1, MAX_TENTATIVAS + 1):
        nome = input('Usuário: ').strip().lower()
        senha = getpass('Senha: ')
        dados = usuarios.get(nome)
        if dados and dados["senha"] == senha:
            print(f'\nBem-vindo, {nome}! (perfil: {dados["perfil"]})')
            return nome, dados["perfil"]
        restantes = MAX_TENTATIVAS - tentativa
        if restantes:
            print(f'Usuário ou senha incorretos. Tentativas restantes: {restantes}')
    print('Número máximo de tentativas excedido.')
    return None


def exige_admin(perfil):
    if perfil != 'admin':
        print('⛔ Acesso negado: esta opção é apenas para administradores.')
        return False
    return True

def consultar_estoque():
    print('\n--- ESTOQUE ATUAL ---')
    for produto, quantidade in estoque.items():
        print(f'Produto: {produto} | Quantidade: {quantidade}')


def retirar_produtos(usuario):
    print('\n--- RETIRADA DE PRODUTOS ---')
    while True:
        produto = input('\nQual item você deseja retirar do estoque? ').lower().strip()

        if produto not in estoque:
            print(f"Produto '{produto}' não encontrado no estoque.")
        elif estoque[produto] == 0:
            print(f"O produto '{produto}' está esgotado.")
        else:
            qtd = ler_numero(f'Quantas unidades de "{produto}" deseja retirar? ')
            if qtd is not None:
                if qtd > estoque[produto]:
                    print(f"Quantidade insuficiente! Temos apenas {estoque[produto]} "
                          f"unidade(s) de '{produto}'.")
                else:
                    estoque[produto] -= qtd
                    registrar(usuario, 'RETIRADA', produto, qtd)
                    print(f"Retirada de {qtd} {produto}(s) realizada com sucesso! "
                          f"Estoque restante: {estoque[produto]}")
                    if estoque[produto] == 0:
                        print(f"🔴 Atenção: '{produto}' ficou ESGOTADO.")
                    elif estoque[produto] <= LIMITE_BAIXO:
                        print(f"⚠️ Atenção: estoque baixo de '{produto}'.")

        if not confirmar('\nDeseja retirar mais algum produto?'):
            break


def ver_historico():
    print('\n--- HISTÓRICO DE MOVIMENTAÇÕES ---')
    if not historico:
        print('Nenhuma movimentação registrada ainda.')
        return
    for i, reg in enumerate(historico, start=1):
        print(f"{i:>3}. [{reg['data']}] {reg['tipo']:<9} | "
              f"{reg['produto']} x{reg['quantidade']} | por {reg['usuario']}")


def repor_estoque(usuario, perfil):
    if not exige_admin(perfil):
        return
    print('\n--- REPOSIÇÃO DE ESTOQUE ---')
    produto = input('Qual produto deseja repor? ').lower().strip()
    if produto not in estoque:
        print(f"Produto '{produto}' não encontrado. Use a opção de cadastrar produto novo.")
        return
    qtd = ler_numero(f'Quantas unidades de "{produto}" chegaram? ')
    if qtd is not None:
        estoque[produto] += qtd
        registrar(usuario, 'REPOSIÇÃO', produto, qtd)
        print(f"Reposição feita! Estoque de '{produto}': {estoque[produto]}")


def cadastrar_produto(usuario, perfil):
    if not exige_admin(perfil):
        return
    print('\n--- CADASTRAR PRODUTO NOVO ---')
    produto = input('Nome do produto: ').lower().strip()
    if produto == '':
        print('O nome não pode ficar vazio.')
    elif produto in estoque:
        print('Esse produto já existe! Use a opção de repor estoque.')
    else:
        qtd = ler_numero('Quantidade inicial: ')
        if qtd is not None:
            estoque[produto] = qtd
            registrar(usuario, 'CADASTRO', produto, qtd)
            print(f"Produto '{produto}' cadastrado com {qtd} unidade(s)!")


def buscar_produto():
    print('\n--- BUSCAR PRODUTO ---')
    termo = input('Digite parte do nome: ').lower().strip()
    if termo == '':
        print('Digite pelo menos uma letra para buscar.')
        return
    achados = {p: q for p, q in estoque.items() if termo in p}
    if not achados:
        print('Nenhum produto encontrado.')
    for p, q in achados.items():
        print(f'Produto: {p} | Quantidade: {q}')


def estoque_baixo():
    print('\n--- ALERTA DE ESTOQUE BAIXO ---')
    baixos = [(p, q) for p, q in estoque.items() if q <= LIMITE_BAIXO]
    if not baixos:
        print('Nenhum produto com estoque baixo. Tudo certo! ✅')
    for p, q in baixos:
        if q == 0:
            print(f'🔴 {p}: ESGOTADO')
        else:
            print(f'⚠️ {p}: apenas {q} unidade(s)')


def totais_retirados():
    totais = {}
    for reg in historico:
        if reg['tipo'] == 'RETIRADA':
            totais[reg['produto']] = totais.get(reg['produto'], 0) + reg['quantidade']
    return totais


def relatorio():
    print('\n===== RELATÓRIO DO ESTOQUE =====')
    print(f'Produtos cadastrados: {len(estoque)}')
    print(f'Total de unidades em estoque: {sum(estoque.values())}')

    maior = max(estoque.values())
    menor = min(estoque.values())
    print(f"Maior estoque ({maior} un.): {', '.join(p for p, q in estoque.items() if q == maior)}")
    print(f"Menor estoque ({menor} un.): {', '.join(p for p, q in estoque.items() if q == menor)}")

    retiradas = totais_retirados()
    if retiradas:
        print('\nRetiradas por produto:')
        for item, total in sorted(retiradas.items(), key=lambda x: x[1], reverse=True):
            print(f'  {item}: {total} unidade(s) retirada(s)')
        top = max(retiradas, key=retiradas.get)
        print(f'\n🏆 Produto mais retirado: {top}')
    else:
        print('\nNenhuma retirada realizada ainda.')

    total_repostos = sum(r['quantidade'] for r in historico if r['tipo'] == 'REPOSIÇÃO')
    print(f'Total de unidades repostas: {total_repostos}')


def encerrar():
    print('\nEncerrando programa...')
    retiradas = totais_retirados()
    if retiradas:
        sorteado = random.choice(list(retiradas))
        print(f'O item sorteado da rodada, baseado na movimentação de estoque, foi [{sorteado}]!')


# PROGRAMA PRINCIPAL

def main():
    sessao = login()
    if sessao is None:
        return
    usuario, perfil = sessao

    while True:
        print(f'\n===== MENU DE ESTOQUE ({usuario} - {perfil}) =====')
        print('1 - Consultar estoque')
        print('2 - Retirar produto')
        print('3 - Ver histórico de movimentações')
        print('4 - Repor estoque (admin)')
        print('5 - Cadastrar produto novo (admin)')
        print('6 - Buscar produto')
        print('7 - Alerta de estoque baixo')
        print('8 - Relatório do estoque')
        print('9 - Sair')

        try:
            opcao = int(input('\nEscolha uma opção: '))
        except ValueError:
            print('Opção inválida, digite um número de 1 a 9.')
            continue

        if opcao == 1:
            consultar_estoque()
            if confirmar('\nDeseja realizar a retirada de algum produto?'):
                retirar_produtos(usuario)
        elif opcao == 2:
            retirar_produtos(usuario)
        elif opcao == 3:
            ver_historico()
        elif opcao == 4:
            repor_estoque(usuario, perfil)
        elif opcao == 5:
            cadastrar_produto(usuario, perfil)
        elif opcao == 6:
            buscar_produto()
        elif opcao == 7:
            estoque_baixo()
        elif opcao == 8:
            relatorio()
        elif opcao == 9:
            encerrar()
            break
        else:
            print('Opção inválida, escolha um número de 1 a 9.')


if __name__ == '__main__':
    main()

#FIM DO PROGRAMAS